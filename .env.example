# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://eve_user:eve_password@localhost:5432/eve_healthcare?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_MAX=20

# Cache TTLs (seconds)
CACHE_TTL_CENTRES=300
CACHE_TTL_TESTS=300

# CORS
CORS_ORIGIN=*

# Test database (used only during testing)
TEST_DATABASE_URL="postgresql://eve_user:eve_password@localhost:5432/eve_healthcare_test?schema=public"
